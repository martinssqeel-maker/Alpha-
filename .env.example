# Alpha AI Workspace — backend/Function environment
#
# Copy to `.env.local` (gitignored) and fill in the values, then deploy:
#
#   npm run deploy          # see package.json -> scripts.deploy
#
# `.env.local` is the source of truth for the deployed Function's environment:
# `neon.ts` forwards only the keys it lists AND that are present here, so a key
# you simply delete from this file is LEFT AS-IS on the live Function. To turn
# something off you must set it explicitly (e.g. AUTH_DEV_ECHO_OTP=0).
#
# The four Neon-managed values (DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_BRANCH,
# NEON_FUNCTION_API_BASE_URL) are injected by `neon deploy`; you do not need to
# fill them in by hand.

# ── Required ────────────────────────────────────────────────────────────────
# Signing key for HS256 session access tokens. 32+ random bytes, base64 or hex.
# Rotating this immediately invalidates every outstanding *access* token; refresh
# tokens live as hashes in Postgres, so clients recover without signing in again.
AUTH_JWT_SECRET=

# Server-side pepper for hashing OTP codes and refresh tokens (never leaves the server).
AUTH_PEPPER=

# ── Auth tuning (optional; defaults are shown) ──────────────────────────────
AUTH_ACCESS_TTL_MIN=60
AUTH_SESSION_TTL_DAYS=30
AUTH_OTP_TTL_MIN=10
AUTH_MAX_ATTEMPTS=6

# Security-critical: never enable on a deployed Function.
# When truthy it returns the live OTP code AND magic-link token in the HTTP
# response to any caller, for any email address (full account takeover).
# The code additionally requires NODE_ENV=development before echoing.
AUTH_DEV_ECHO_OTP=0

# Comma-separated browser origins allowed to call the API from a page.
# `*` (or unset) makes CORS reflect ANY origin. Set your real website/admin origins.
ALLOWED_ORIGINS=

# ── Email ──────────────────────────────────────────────────────────────────
# These send the *sign-in* email (six-digit code + one-tap link). It is the only
# message the product sends: accounts are created on the first verified sign-in, so
# there is no separate "verify your address" mail, and ordinary users have no
# password to reset — the only password is the administrator's, seeded on the
# operator's machine with `npm run admin:password`.
#
# `log` writes the one-time code to the Function logs and delivers NOTHING, while
# still answering "we sent a code". It exists so a developer can complete a sign-in
# without a mailbox. Never leave it on for real users; the API answers
# `"delivered": false` when it is in use.
# `resend` sends real email through https://api.resend.com and requires
# RESEND_API_KEY (below).
EMAIL_PROVIDER=log

# The sender every message is sent as. Resend refuses a from-address on a domain
# that is not verified in the account, so this must be one of:
#   * an address at a domain you have verified in Resend (Resend -> Domains), or
#   * exactly `onboarding@resend.dev`, which Resend permits for testing but which
#     can only deliver to the address that owns the Resend account.
# A rejected sender comes back as HTTP 422 `validation_error` and is NOT retried.
# With this key unset the API uses `Alpha AI Workspace <onboarding@resend.dev>`.
# The display name is free text; the address is the part Resend validates.
EMAIL_FROM=Alpha AI Workspace <onboarding@resend.dev>

# Optional Reply-To, for when you want replies to land somewhere you read.
EMAIL_REPLY_TO=

# Create this at https://resend.com/api-keys (Sending access is enough). Put the
# value ONLY here, in the gitignored `.env.local` — never in a browser field, a
# commit, a chat message or the database — then run `npm run deploy`. The value
# never leaves the Function: no endpoint returns it, and provider errors are
# scrubbed of anything shaped like a key before they reach the logs.
RESEND_API_KEY=

# ── Sign-in email volume control ───────────────────────────────────────────────
# POST /auth/request is unauthenticated and mails an address the caller chooses,
# so it is capped per address and per source IP. The cooldown collapses a
# double-clicked "Email me a sign-in link" into one message instead of two, and
# every request that is actually mailed is counted. Throttled requests are not
# counted, so hammering the endpoint cannot extend the caller's own lockout.
AUTH_OTP_REQUEST_MAX=3
AUTH_OTP_REQUEST_IP_MAX=10
AUTH_OTP_REQUEST_WINDOW_MIN=15
AUTH_OTP_RESEND_COOLDOWN_SEC=60

# Base URL of the website account page. When set, the magic link points at
#   {WEB_ACCOUNT_URL}/account?email=…&token=…
# (the site serves clean URLs, so `/account` is the canonical address).
# Otherwise it falls back to the desktop deep link `{AUTH_APP_SCHEME}://auth/callback`.
WEB_ACCOUNT_URL=

# ── Sign-in providers ──────────────────────────────────────────────────────
# Both providers are optional: a button appears only once its credentials exist
# here, so leaving a pair blank simply hides that button.
#
# Google: Console -> APIs & Services -> Credentials -> OAuth client ID -> "Web
# application". Add {base}/auth/google/callback as an Authorized redirect URI.
#
# GOOGLE_CLIENT_SECRET must be the secret shown for THAT SAME client id (it looks
# like GOCSPX-…). A secret from another client, or one that has since been reset,
# makes Google answer the token exchange with 401 invalid_client — sign-in fails
# after the consent screen with no clue why. The API now reports that case as
# `google_misconfigured` (see docs/platform/MANUAL-TODO.md §7b).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed when the callback cannot be derived from the request URL.
# Set this to the same URL you add as an Authorized redirect URI in the Google Cloud Console.
# e.g. https://alpha-website-lime.vercel.app/auth/google/callback
GOOGLE_REDIRECT_URI=https://alpha-website-lime.vercel.app/auth/google/callback

# GitHub: GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App.
# Authorization callback URL: {base}/auth/github/callback# Sign-in requests identity only (read:user user:email) and never `repo`, so it# cannot grant repository access — connecting repositories is a separate action.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set this to the same URL you add as an Authorization callback URL in the GitHub OAuth App settings.# e.g. https://alpha-website-lime.vercel.app/auth/github/callback
GITHUB_REDIRECT_URI=https://alpha-website-lime.vercel.app/auth/github/callback

# ── AI providers ───────────────────────────────────────────────────────────
# Shared cloud inference. Every provider call is made by the Function, never by
# the desktop app or the browser, so these values never leave the server. The
# provider row in public.ai_providers names the variable it reads (api_key_env).
#
# OpenRouter is the shared provider users get without their own account. Put the
# key here (this file is committed; .env.local is not) and deploy:
#
#   npm run deploy
#
# A new value takes effect for the next request. To confirm a rotation without
# ever printing the key, the admin API reports only a short hash of it.
#
# Two provider-side limits are worth knowing, because they are per *account*, not
# per user: below a $10 lifetime purchase OpenRouter allows 20 requests/minute and
# 50/day for free (`:free`) models, and failed attempts count towards the daily
# figure. That is why limit.requests_day exists in the plan configuration and why
# the free plan's own ceiling is deliberately lower.
OPENROUTER_API_KEY=

# Preferred: the Neon AI Gateway (one credential for every provider).
# When both of these are set, they take precedence over every per-provider key.
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=

# Alternative: per-provider keys. The name must match the `api_key_env` column of
# that provider's row in public.ai_providers, or PROVIDER_API_KEY_<CODE> by default.
PROVIDER_API_KEY_OPENAI=
PROVIDER_API_KEY_ANTHROPIC=
PROVIDER_API_KEY_GROQ=

# ── Local release publishing only (not a Function variable) ────────────────
# Fine-grained GitHub token with Contents: read/write, used by `npm run release`.
GH_TOKEN=
