# website/config.js IS committed on purpose: the site serves it as a plain static
# file so a deployment never depends on a Vercel build step. Regenerate it with
# `node website/gen-config.mjs` (see website/README.md).
admin/node_modules/
admin/dist/
admin/.env
supabase/.temp/
.neon

# Secrets. `.env` was NOT ignored before, so a real key file dropped at the repo
# root could be committed by accident. Templates stay tracked.
.env
.env.*
!.env.example
admin/.env

# Local GitHub OAuth app config. The Client ID is a public identifier, but it is
# machine-specific here, so it stays out of the repository. See HANDOVER.md for
# where to place it (repo root for dev; userData for a packaged install).
github-oauth.json
github-oauth.local.json
