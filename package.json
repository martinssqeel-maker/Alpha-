{
  "name": "alpha-ai-workspace",
  "version": "1.0.6",
  "description": "Alpha AI Workspace - a premium local-first Windows desktop AI development environment that connects to your existing Ollama models, cloud providers, project folders and GitHub.",
  "main": "./out/main/index.js",
  "author": "Alpha AI Workspace",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder --win nsis",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "release": "electron-vite build && electron-builder --win nsis --publish always & node scripts/ensure-release.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "admin:password": "node scripts/admin-password.mjs",
    "deploy": "node scripts/deploy.mjs",
    "check:oauth": "node scripts/check-oauth-credentials.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:admin": "node scripts/verify-admin.mjs",
    "smoke:desktop": "node scripts/desktop-smoke.mjs",
    "serve:website": "node scripts/serve-website.mjs",
    "stub:api": "node scripts/stub-platform-api.mjs",
    "bench:chat": "vitest run --config vitest.bench.config.ts"
  },
  "dependencies": {
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3",
    "@neon/functions": "^0.11.0",
    "@supabase/supabase-js": "^2.117.3",
    "diff": "^8.0.2",
    "electron-updater": "^6.8.9",
    "hono": "^4.13.13",
    "ignore": "^7.0.12",
    "jose": "^6.2.12",
    "pdf-parse": "^1.1.1",
    "sql.js": "^1.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.10.0",
    "lucide-react": "^0.469.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "zustand": "^5.0.2"
  }
}
