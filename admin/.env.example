# Alpha Admin dashboard — API connection
#
# Copy to .env.local (or .env) and set the Neon Function base URL, then build:
#   npm run build     # tsc --noEmit && vite build  ->  admin/dist
#
# This is a build-time variable: Vite inlines it, so changing it requires a rebuild.
# It is a public value — it ends up in the shipped bundle. Never put a secret here.
VITE_API_BASE_URL=
